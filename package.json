{
  "name": "autonomous-ai-creator",
  "version": "1.0.0",
  "description": "Autonomous AI Research and Creation Platform — From Prompt-Driven to Curiosity-Driven AI",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && vite build client",
    "start": "node dist/server.js",
    "dev:backend": "npm run build && node dist/server.js",
    "dev:frontend": "vite client --port 5173",
    "dev": "npm run build && node dist/server.js",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "node --test dist/**/*.test.js",
    "demo": "npm run build && node dist/scripts/run-demo.js"
  },
  "keywords": [
    "autonomous-ai",
    "ai-agent",
    "curiosity-driven",
    "research",
    "experiments",
    "knowledge-graph"
  ],
  "author": "Google DeepMind AGY Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serverless-http": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
