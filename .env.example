# Autonomous AI Creator Configuration

PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Storage Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_creator
REDIS_URL=redis://localhost:6379

# AI Provider Credentials
LLM_PROVIDER=mock # Options: mock, gemini, openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-pro

EMBEDDING_PROVIDER=mock # Options: mock, openai, gemini
EMBEDDING_API_KEY=your_embedding_api_key_here

SEARCH_PROVIDER=mock # Options: mock, serpapi, tavily
SEARCH_API_KEY=your_search_api_key_here

NEWS_API_KEY=your_news_api_key_here
GITHUB_TOKEN=your_github_token_here

# Social Publishing API Keys
SOCIAL_X_API_KEY=your_x_api_key
SOCIAL_LINKEDIN_TOKEN=your_linkedin_token

# Autonomy & Safety Settings
DEFAULT_AUTONOMY_LEVEL=3 # Level 1 (Research Only) to Level 5 (Fully Autonomous)
QUALITY_THRESHOLD_APPROVE=75
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MEMORY_LIMIT_MB=128
